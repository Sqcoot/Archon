{
  "schemaVersion": "aco.migration-order-plan.v1",
  "sourceBranch": "codex/aco-stabilization-slices",
  "baseBranch": "dev",
  "phases": [
    {
      "id": "S2",
      "ownerPackage": "@archon/aco-core",
      "goal": "Project reference surface plan into typed manifests and run the read-only compatibility gate.",
      "dependsOn": ["S0", "S1"],
      "parityGate": "reference-surface-compatibility-gate",
      "mustRemainPure": true,
      "runtimeMigrationAllowed": false
    },
    {
      "id": "S3",
      "ownerPackage": "@archon/aco-ledgers",
      "goal": "First read-only compatibility migration slice for archon context ledgers.",
      "dependsOn": ["S2"],
      "parityGate": "ledger-fixture-parity-gate",
      "mustRemainPure": true,
      "runtimeMigrationAllowed": false
    },
    {
      "id": "S4-plus",
      "ownerPackage": "deferred",
      "goal": "Defer remaining CLI, workflow, server, web, provider, graph, hook, auth, MCP, and artifact writer migrations until S2/S3 gates pass.",
      "dependsOn": ["S2", "S3"],
      "parityGate": "future-surface-parity-gate",
      "mustRemainPure": false,
      "runtimeMigrationAllowed": true
    }
  ],
  "preservedSurfaces": [
